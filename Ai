<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber AI - Smart Assistant</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #e0e0e0;
            margin: 0;
            display: flex;
            justify-content: center;
            height: 100vh;
        }
        .chat-container {
            width: 100%;
            max-width: 800px;
            background-color: #1e1e1e;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        .header {
            padding: 15px 20px;
            background-color: #2d2d2d;
            border-bottom: 1px solid #333;
            text-align: center;
        }
        .header h1 { margin: 0; color: #00ff88; font-size: 24px; }
        
        /* Secure API Management Bar */
        .api-bar {
            background-color: #1a1a1a;
            padding: 10px 20px;
            display: flex;
            gap: 10px;
            align-items: center;
            border-bottom: 1px solid #2d2d2d;
        }
        .api-bar label {
            font-size: 12px;
            color: #00ff88;
            font-weight: bold;
        }
        .api-bar input {
            flex: 1;
            padding: 6px 10px;
            background-color: #252525;
            border: 1px solid #444;
            color: #fff;
            border-radius: 4px;
            font-size: 12px;
        }
        .api-bar button {
            padding: 6px 12px;
            font-size: 12px;
        }

        .chat-box {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .message {
            max-width: 80%;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 15px;
            line-height: 1.4;
        }
        .user-msg {
            align-self: flex-end;
            background-color: #007bff;
            color: white;
            border-bottom-right-radius: 2px;
        }
        .ai-msg {
            align-self: flex-start;
            background-color: #333;
            color: #d1d1d1;
            border-bottom-left-radius: 2px;
        }
        .input-area {
            padding: 20px;
            background-color: #2d2d2d;
            display: flex;
            gap: 10px;
        }
        input[type="text"] {
            flex: 1;
            padding: 12px;
            border-radius: 5px;
            border: 1px solid #444;
            background-color: #1e1e1e;
            color: white;
            outline: none;
        }
        button {
            padding: 12px 20px;
            background-color: #00ff88;
            border: none;
            border-radius: 5px;
            color: black;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover { background-color: #00cc6a; }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="header">
        <h1>Cyber AI 🤖</h1>
        <small>Universal AI System</small>
    </div>

    <!-- User inputs key directly. Saved safely in local storage -->
    <div class="api-bar">
        <label for="apiKey">Gemini API Key:</label>
        <input type="password" id="apiKey" placeholder="Paste your AIzaSy... key here" onchange="saveKey()">
    </div>
    
    <div class="chat-box" id="chatBox">
        <div class="message ai-msg">Hello! To wake me up, please paste your free Gemini API Key from Google AI Studio into the input bar above. Once added, I can answer absolutely any question on earth!</div>
    </div>

    <div class="input-area">
        <input type="text" id="userInput" placeholder="Ask anything (GK, coding, homework...)" onkeypress="handleEnter(event)">
        <button onclick="sendMessage()">Send</button>
    </div>
</div>

<script>
    const chatBox = document.getElementById('chatBox');
    const userInput = document.getElementById('userInput');
    const apiKeyInput = document.getElementById('apiKey');

    // Auto-load key from browser storage on refresh
    window.onload = function() {
        const savedKey = localStorage.getItem('user_gemini_key');
        if (savedKey) {
            apiKeyInput.value = savedKey;
        }
    }

    function saveKey() {
        localStorage.setItem('user_gemini_key', apiKeyInput.value.trim());
    }

    function handleEnter(e) {
        if (e.key === 'Enter') sendMessage();
    }

    async function sendMessage() {
        const text = userInput.value.trim();
        const apiKey = apiKeyInput.value.trim();

        if (!text) return;

        if (!apiKey) {
            alert("Please paste your Google Gemini API Key in the top input bar first!");
            return;
        }

        // 1. Post user question
        addMessage(text, 'user-msg');
        userInput.value = '';

        // 2. Put loading text
        const loadingDiv = addMessage("Thinking...", 'ai-msg');

        try {
            // Secure connection to global Google Gemini Model
            const response = await fetch(`https://googleapis.com{apiKey}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contents: [{ parts: [{ text: text }] }]
                })
            });

            const data = await response.json();
            
            if(data.error) {
                loadingDiv.innerText = `API Error: ${data.error.message}`;
                return;
            }

            const aiText = data.candidates[0].content.parts[0].text;
            loadingDiv.innerText = aiText;

        } catch (error) {
            loadingDiv.innerText = "Connection lost. Please make sure your API Key is completely valid.";
            console.error(error);
        }
    }

    function addMessage(text, className) {
        const div = document.createElement('div');
        div.className = `message ${className}`;
        div.innerText = text;
        chatBox.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
        return div;
    }
</script>

</body>
</html>
                      
